# =========================================================
#  SkillPilot AI — settings
#  1. Copy this file and name the copy:  .env
#  2. Put your real API key in .env (never share that file!)
# =========================================================

# Which AI to use:  gemini  |  claude  |  openai  |  demo
# (demo = sample answers, no key needed)
AI_PROVIDER=gemini

# ---- Google Gemini (has a free tier) ----
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash

# ---- Anthropic Claude ----
# Get a key: https://platform.claude.com  (API Keys section)
ANTHROPIC_API_KEY=your-anthropic-key-here
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ---- OpenAI ----
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-6-luna

# Website port (open http://localhost:3000)
PORT=3000

# Max AI requests per visitor every 10 minutes (protects your bill)
RATE_LIMIT=30
