# =========================================================
#  SkillPilot AI — settings (example only, no real keys here)
#  On your laptop: copy this file, name the copy  .env  and fill it in.
#  On Render.com: add these as "Environment Variables" instead.
#  NEVER upload your real .env file to GitHub.
# =========================================================

# Which AI to use:  gemini  |  claude  |  openai  |  demo
AI_PROVIDER=gemini

# ---- Google Gemini (has a free tier) ----
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash

# ---- Anthropic Claude (optional) ----
ANTHROPIC_API_KEY=your-anthropic-key-here
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ---- OpenAI (optional) ----
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-6-luna

# ---- Supabase (accounts + saved resumes) ----
# Use the PUBLISHABLE key (sb_publishable_...), never the secret key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-key-here

# Website port (Render sets this by itself)
PORT=3000

# Max AI requests per visitor every 10 minutes
RATE_LIMIT=30

# Set to 1 only when hosted behind Render / a proxy
TRUST_PROXY=0
